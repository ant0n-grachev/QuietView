{
  "manifest_version": 3,
  "name": "QuietView",
  "version": "1.1.1",
  "version_name": "v1.1.1",
  "minimum_chrome_version": "119",
  "description": "Best-effort always-visible, focused and single-display readouts. No telemetry. See included limitations.",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": { "128": "icon128.png" },
  "action": {
    "default_title": "QuietView",
    "default_popup": "popup.html",
    "default_icon": { "128": "icon128.png" }
  }
}
